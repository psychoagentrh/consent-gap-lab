{
  "workflows": [
    {
      "id": "consent-observation",
      "package": "uipath/packages/Psycho.ConsentGap.flow.Flow.1.0.0.nupkg",
      "inputs": {
        "specimenCase": {
          "type": "string",
          "enum": ["unlimited", "bounded"]
        }
      },
      "outputs": ["specimenCaseObserved", "scopeExceedsButton", "approvalIsSwap", "verdict", "fixtureSchema", "payloadDigest", "observedAt", "method"]
    },
    {
      "id": "unsigned-approval-observation",

      "package": "uipath/packages/Psycho.UnsignedApproval.flow.Flow.1.1.0.nupkg",

      "inputs": {
        "approvalCase": { "type": "string", "enum": ["maximum", "bounded", "spender-match", "spender-mismatch"] }
      },
      "outputs": ["approvalCaseObserved", "spender", "expectedSpender", "spenderComparison", "rawAllowance", "claimedRawAmount", "comparison", "scopeExceedsButton", "approvalIsSwap", "verdict", "fixtureSchema", "payloadDigest", "observedAt", "method"]
    }
  ]
}
