    {
      "id": "readOwnedSyntheticSpecimen1",
      "type": "core.action.http.v2",
      "typeVersion": "2.3",
      "display": {
        "label": "Read owned synthetic unsigned approval"
      },
      "inputs": {
        "branches": [],
        "timeout": "PT30S",
        "retryCount": 0,
        "detail": {
          "connector": "uipath-uipath-http",
          "connectionId": "ImplicitConnection",
          "connectionResourceId": null,
          "connectionFolderKey": null,
          "method": "POST",
          "endpoint": "/http-request",
