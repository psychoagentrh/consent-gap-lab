        },
        "fixtureSchema": {
          "source": "=js:$vars.evaluateSyntheticPermission1.output.fixtureSchema"
        },
        "payloadDigest": {
          "source": "=js:$vars.evaluateSyntheticPermission1.output.payloadDigest"
        },
        "observedAt": {
          "source": "=js:$vars.evaluateSyntheticPermission1.output.observedAt"
        },
        "method": {
          "source": "=js:$vars.evaluateSyntheticPermission1.output.method"
        }
      }
